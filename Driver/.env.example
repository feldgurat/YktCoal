# ── Окружение ──────────────────────────────────────────────────
# production | staging | development. В проде — production (debug-ручки выключены).
ENVIRONMENT=production

# ── PostgreSQL ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/driver_db

# ── Redis (общий с User и Order) ───────────────────────────────
REDIS_URL=redis://:PASSWORD@HOST:PORT/0

# ── JWT (общий секрет с User-сервисом) ─────────────────────────
JWT_SECRET=replace-with-long-random-secret
JWT_ALGORITHM=HS256

# ── Internal / Telegram service keys (те же, что в User) ───────
INTERNAL_SERVICE_KEY=replace-with-internal-secret
INTERNAL_TELEGRAM_SERVICE_KEY=replace-with-telegram-secret

# ── URL соседних сервисов ──────────────────────────────────────
USER_SERVICE_URL=http://user-backend:8000

# ── CORS ───────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# ── Uploads ────────────────────────────────────────────────────
UPLOADS_DIR=/data/uploads
UPLOAD_MAX_BYTES=10485760
