# ── Telegram ───────────────────────────────────────────────────
BOT_TOKEN=replace-with-bot-token

# ── Backend-сервисы ────────────────────────────────────────────
# Значения по умолчанию совпадают с именами сервисов в корневом docker-compose.
USER_SERVICE_URL=http://user-backend:8000
ORDER_SERVICE_URL=http://order-backend:8001

# Общий сервисный ключ Telegram-эндпоинтов бэкенда (X-Service-Key).
# Должен совпадать с INTERNAL_TELEGRAM_SERVICE_KEY в User- и Order-сервисах.
INTERNAL_TELEGRAM_SERVICE_KEY=replace-with-telegram-secret

# ── HTTP ───────────────────────────────────────────────────────
HTTP_TIMEOUT_SECONDS=10.0
