# ── Окружение ──────────────────────────────────────────────────
# production | staging | development. В проде — production (debug-ручки выключены).
ENVIRONMENT=production

# ── PostgreSQL ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME

# ── Redis ──────────────────────────────────────────────────────
REDIS_URL=redis://:PASSWORD@HOST:PORT/0

# ── JWT ────────────────────────────────────────────────────────
JWT_SECRET=replace-with-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── OTP ────────────────────────────────────────────────────────
OTP_TTL_SECONDS=300
OTP_RATE_LIMIT_SECONDS=60
OTP_CODE_LENGTH=6
OTP_MAX_ATTEMPTS=5
# Только для разработки: печатать OTP-код в лог сервера (SMS-провайдер не нужен).
# В проде обязательно false.
OTP_DEBUG=false

# ── Default admin ──────────────────────────────────────────────
DEFAULT_ADMIN_NAME=Admin
DEFAULT_ADMIN_PHONE=+70000000000

# ── Internal / CORS ────────────────────────────────────────────
INTERNAL_SERVICE_KEY=replace-with-internal-secret
INTERNAL_TELEGRAM_SERVICE_KEY=replace-with-telegram-secret
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
COOKIE_SECURE=false